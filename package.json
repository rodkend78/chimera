{
  "name": "@team-rsi/chimera-gateway-poc",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "A local, model-independent agent workspace and authorization control plane.",
  "license": "Apache-2.0",
  "author": "Rod Kendrick",
  "repository": {
    "type": "git",
    "url": "https://github.com/rodkend78/chimera.git"
  },
  "bugs": {
    "url": "https://github.com/rodkend78/chimera/issues"
  },
  "homepage": "https://github.com/rodkend78/chimera#readme",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "vite build --config app/vite.config.js",
    "demo": "node src/demo.mjs",
    "dev": "node --env-file-if-exists=.env src/browser/dev.mjs",
    "dev:api": "node --env-file-if-exists=.env src/browser/server.mjs",
    "dev:app": "vite --config app/vite.config.js",
    "pilot": "npm run build && node --env-file-if-exists=.env scripts/pilot/start.mjs",
    "pilot:check": "node --env-file-if-exists=.env scripts/pilot/check.mjs",
    "pilot:ade-acceptance": "node scripts/pilot/ade-acceptance.mjs",
    "pilot:up": "npm run build && node scripts/pilot/service.mjs up",
    "pilot:status": "node scripts/pilot/service.mjs status",
    "pilot:down": "node scripts/pilot/service.mjs down",
    "pilot:restart": "npm run build && node scripts/pilot/service.mjs restart",
    "start": "node --env-file-if-exists=.env src/browser/server.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "gate1:verify-inventory": "node scripts/gate1/verify-upstream-inventory.mjs ../deepseek-harness-upstream",
    "gate1:verify-cordis": "node scripts/gate1/verify-cordis-enforcement.mjs ../deepseek-harness-upstream",
    "gate2:bundle:audit": "node scripts/gate2/bundle-lambda.mjs audit-writer src/aws/audit-writer-handler.mjs",
    "gate2:bundle:anchor": "node scripts/gate2/bundle-lambda.mjs audit-anchor-writer src/aws/audit-anchor-writer.mjs",
    "gate2:bundle:signing": "node scripts/gate2/bundle-lambda.mjs signing-broker src/aws/signing-broker-handler.mjs",
    "gate2:init:nostr": "node scripts/gate2/initialize-nostr-custody.mjs",
    "gate2:validate-template": "aws cloudformation validate-template --region us-west-2 --template-body file://infra/chimera-pilot-artifacts.json && aws cloudformation validate-template --region us-west-2 --template-body file://infra/chimera-pilot-gate2.json",
    "gate0b:verify-config": "node -e \"import('./src/gate0b/evidence.mjs').then(async m => m.validateSoakConfig(JSON.parse(await (await import('node:fs/promises')).readFile('config/gate0b-soak.json', 'utf8'))))\""
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "3.1120.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1121.0",
    "@aws-sdk/client-bedrock-runtime": "3.1120.0",
    "@aws-sdk/client-dynamodb": "^3.1120.0",
    "@aws-sdk/client-lambda": "3.1120.0",
    "@aws-sdk/client-s3": "3.1120.0",
    "@aws-sdk/client-secrets-manager": "3.1120.0",
    "@aws-sdk/client-ssm": "3.1120.0",
    "@aws-sdk/credential-provider-node": "^3.972.81",
    "@aws-sdk/s3-request-presigner": "3.1120.0",
    "@cloudscape-design/components": "^3.0.1356",
    "@cloudscape-design/design-tokens": "^3.0.109",
    "@cloudscape-design/global-styles": "^1.0.67",
    "@openai/codex-sdk": "0.150.1",
    "@smithy/signature-v4": "^5.7.3",
    "@vitejs/plugin-react": "^6.1.0",
    "bedrock-agentcore": "^0.4.3",
    "lucide-react": "^1.33.0",
    "nostr-tools": "^2.24.3",
    "playwright": "^1.62.1",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
