{
  "manifest_version": 3,
  "name": "Chimera Account Companion",
  "version": "0.1.0",
  "minimum_chrome_version": "106",
  "description": "Explicitly share the selected document read-only with a Chimera task.",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Share with Chimera" }
}
