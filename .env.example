# Copy this file to .env, keep it mode 600, and keep real values local.
# Optional fallback. Chimera prefers the existing AWS credential chain (SigV4).
CHIMERA_BEDROCK_MANTLE_API_KEY=

# Browser streaming defaults to the Sharp profile: 1600x900 JPEG at quality 85.
# Optional bounded overrides: width 1280-1920, height 720-1080, quality 60-92.
CHIMERA_BROWSER_VIEWPORT_WIDTH=
CHIMERA_BROWSER_VIEWPORT_HEIGHT=
CHIMERA_BROWSER_STREAM_QUALITY=

# Hermes discovery is opt-in. There is no default instance, host, or vault bucket.
# Leave these empty unless you intend to connect a test Hermes target.
CHIMERA_HERMES_INSTANCE_ID=
CHIMERA_HERMES_HOST=
CHIMERA_HERMES_BACKUP_BUCKET=
CHIMERA_HERMES_BACKUP_PREFIX=

# Optional Google client-intake connector. Account and form are independently
# validated; leave either empty to keep that portion of intake unavailable.
CHIMERA_GOOGLE_CLIENT_FILE=
CHIMERA_GOOGLE_ACCOUNT=
CHIMERA_GOOGLE_FORM_ID=

# Optional RJ AWS worker connector. The first value is the base64 encoding of
# the reviewed worker's PUBLIC Ed25519 key only; never place a private key here.
# Account ID, region, instance ID, role ARN, SSH target, and worker entrypoint
# are required together when the connector is enabled and are pinned into
# every signed request, receipt, and provider identity check. The assumed-role
# prefix is optional and derived when empty; the AWS config path is optional and
# defaults to /etc/chimera/rj-aws/imds-config.
# When empty, Chimera registers no RJ AWS tools and makes no transport attempt.
CHIMERA_RJ_AWS_WORKER_PUBLIC_KEY_BASE64=
CHIMERA_RJ_AWS_ACCOUNT_ID=
CHIMERA_RJ_AWS_REGION=
CHIMERA_RJ_AWS_INSTANCE_ID=
CHIMERA_RJ_AWS_ROLE_ARN=
CHIMERA_RJ_AWS_ASSUMED_ROLE_PREFIX=
CHIMERA_RJ_AWS_SSH_TARGET=
CHIMERA_RJ_AWS_WORKER_ENTRYPOINT=
CHIMERA_RJ_AWS_CONFIG_PATH=

# Optional source attribution allowlist for the Clients workspace. Empty
# denies external source links rather than guessing an operator repository.
VITE_CHIMERA_SOURCE_REPOSITORY=

# Optional owner-only, selected-profile snapshot. Takes precedence over S3.
# Schema and export requirements: docs/HERMES_SNAPSHOT_IMPORT.md.
# This contains private agent content; never commit the file.
CHIMERA_HERMES_SNAPSHOT_FILE=
